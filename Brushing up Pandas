import pandas as pd 

print(pd.__version__)

data = [100, 120, 400,200,204]

series = pd.Series(data, index = ['a', 'b', 'c', 'd', 'e'])# two parameters a list to convert into series and index for the column 
print(series[series <= 200])# filtering a series 


calories = {"Day1": 2000 , "Day2": 2400, "Day3": 1800}

series_dict = pd.Series(calories)
print(series_dict.loc["Day1"])#filtering the data using location by index 
print(series_dict[series_dict < 2000])

#NOW FOR THE DATAFRAME 


datas = {'Name':['Mark', 'Bruce', 'Darrow', 'Paul'],
         'Age': [45,32,20,25]
}

df = pd.DataFrame(datas, index = ['Harvard', 'Gotham', 'Mars', 'Arrakis'])
print(df.loc['Harvard'])

# Add a new column 
df['Job'] = ['Entrepreneur', 'Saviour', 'Break the chains', 'Lead to paradise']
print(df)

#ADDING A NEW ROW 
new_row = pd.DataFrame([{'Name': 'Peter Parker', 'Age': 18, 'Job': 'Become Spiderman'}], index = ['NewYork'])
df = pd.concat([df,new_row])
print(df)
