# Computing cost function for the multiple variable 

def compute_cost_multiple_var(X,y,w,b):
    cost = 0
    m = X.shape[0]
    for i in range(m):
        f_wb_i = np.dot(X[i],w) + b
        cost = cost + (f_wb_i - y[i])**2# cost function j, iterates it in each row of X and train 
    cost = cost/2*m# divide it by two after summation of the cost function 
    return cost

